# Postgres connection string. Locally this points at the `db` service in docker-compose.yaml;
# on Vercel set it to your Neon (or other hosted Postgres) connection string.
DATABASE_URL=postgres://qwerty:qwerty@localhost:55432/qwerty

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app. Locally this is the Vite dev server.
BETTER_AUTH_URL=http://localhost:5173

# Azure Speech (optional): neural voices for FIB/WFD sentences and pronunciation
# assessment for the 跟读 track. Without these the browser's built-in voice is used
# and words read aloud are marked by hand. Free tier: portal.azure.com -> Speech services -> F0.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast
# Optional; default en-GB-SoniaNeural. Any Azure neural voice works, e.g. en-AU-NatashaNeural.
AZURE_TTS_VOICE=
