  "scripts": {
    "dev": "docker compose up -d --wait db && yarn db:migrate && concurrently -k -n api,web -c cyan,magenta \"tsx watch --env-file-if-exists=.env server/dev.ts\" \"vite\"",
    "dev:web": "vite",
    "start": "vite",
    "build": "cross-env CI=false vite build --base=./",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/migrate.ts",
    "admin:create": "tsx --env-file-if-exists=.env server/scripts/create-admin.ts",
    "admin:create:prod": "vercel env pull .env.production.local --environment=production --yes --scope zichen-zhangs-projects > /dev/null && tsx --env-file=.env.production.local server/scripts/create-admin.ts; status=$?; rm -f .env.production.local; exit $status",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "test": "echo \"No tests\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prepare": "husky install"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
